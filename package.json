{
  "name": "five-crowns",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:backup": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/db-backup.mjs",
    "hash-password": "node scripts/hash-password.js",
    "audit:a11y": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/client-ssm": "^3.1164.0",
    "@aws-sdk/s3-presigned-post": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.5.32",
    "sst": "^4.17.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
